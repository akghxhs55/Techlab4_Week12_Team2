<?xml version="1.0" encoding="utf-8"?>
<UserSettings>
  <ApplicationIdentity version="18.0" />
  <ToolsOptions />
  <Category name="Debugger" Category="{EEDBF29A-5C8B-4E01-827C-263382C18CFE}" Package="{C9DD4A57-47FB-11D2-83E7-00C04F9902C1}" RegisteredName="Debugger" PackageName="Visual Studio Debugger">
    <!--PDB에 기록된 Source Link로 빌드 당시 GitHub 소스를 조회한다.-->
    <PropertyValue name="UseSourceLink">1</PropertyValue>
    <!--팀 SymStore 공유 경로를 사용한다.-->
    <PropertyValue name="SymbolPath">\\172.21.10.22\KurisuSymbols</PropertyValue>
    <!--등록한 공유 심볼 경로를 활성화한다.-->
    <PropertyValue name="SymbolPathState">1</PropertyValue>
    <!--서버에서 받은 파일을 현재 사용자의 쓰기 가능한 폴더에 캐시한다.-->
    <PropertyValue name="SymbolCacheDir">%LOCALAPPDATA%\Kurisu\SymbolCache</PropertyValue>
    <!--Windows DLL과 심볼은 Microsoft 서버에서도 검색한다.-->
    <PropertyValue name="SymbolUseMSSymbolServers">1</PropertyValue>
    <!--로컬에 인접한 PDB뿐 아니라 등록된 심볼 경로에서도 자동 검색한다.-->
    <PropertyValue name="AutoLoadFromSymbolPath">1</PropertyValue>
    <PropertyValue name="SymbolsAlwaysLoadAdjacent">1</PropertyValue>
    <!--기존 제외 목록의 영향을 받지 않도록 필요한 모듈을 명시한다.-->
    <PropertyValue name="SymbolUseExcludeList">0</PropertyValue>
    <PropertyValue name="SymbolIncludeList">KurisuEditor.exe;KurisuGame.exe;libfbxsdk.dll;kernelbase.dll;kernel32.dll;ntdll.dll</PropertyValue>
    <PropertyValue name="SymbolIncludeListState">1;1;1;1;1;1</PropertyValue>
  </Category>
</UserSettings>
